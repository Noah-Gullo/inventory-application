<%# GET /:genreName/:bookID %>
<!DOCTYPE html>

<html>
    <head>
        <title><%= book.title %></title>
        <link rel="stylesheet" href="/styles.css">
    </head>

    <body>
        <h1>Book Details</h1>
        <% if (book){ %>
            <div class="bookDetails">
                <p class="title">Title: <%= book.title %></p>
                <p class="authorName">Author Name: <%= author.name %></p>
                <p class="genreName">Genre: <%= genre %></p>
                <p class="releaseDate">Published On: <%= book.release_date %></p>
            </div> 
        <% } else { %>
            <p> No book was found named</p>
        <% } %>
        <a href="/<%= genre %>"> Back to '<%= genre %>' books</a>
    </body>
</html>