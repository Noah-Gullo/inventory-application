<%# GET /:genreName %>
<!DOCTYPE html>

<html>
    <head>
        <title><%= genre %></title>
        <link rel="stylesheet" href="/styles.css">
    </head>

    <body>
        <h1><%= genre %> Books</h1>
        <% if (books.length != 0){ %>
            <% books.forEach((book) => { %>
                <div class="book">
                    <p class="bookTitle"><%= book.title %></p>
                    <form action="/<%= genre %>/<%= book.id %>" method="POST">
                        <button type="submit">View more details</button>
                    </form>

                    <form action="/editBook/<%= genre %>/<%= book.id %>" method="GET">
                        <button type="submit">Edit Details</button>
                    </form>

                    <form action="<%= genre %>/<%= book.id %>/delete" method="POST">
                        <button type="submit">Delete</button>
                    </form>
                </div>
            <% }) %>
        <% } else { %>
            <p> No books were found for '<%= genre %>'</p>
        <% } %>
        <a href="/newBook/<%= genre %>">Add New Book</a>
        <a href="/">Back to Home </a>
    </body>
</html>