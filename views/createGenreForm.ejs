<%# GET /editGenre/:genreName %>
<!DOCTYPE html>

<html>
    <head>
        <title>Inventory Application</title>
        <link rel="stylesheet" href="/styles.css">
    </head>

    <body>
        <h1>Create Genre</h1>
        <form action="/editGenre/<%= genre %>" method="POST">
            <label for="editGenreText">Edit Name: </label>
            <input type="text" name="editGenreText" value="<%= genre %>" required/>
            <button type="submit">Save Edit</button>
        </form>
        <a href="/">Back to Home</a>
    </body>
</html>