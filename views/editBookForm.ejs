<%# GET /editBook/:genreName %>
<!DOCTYPE html>

<html>
    <head>
        <title>Inventory Application</title>
        <link rel="stylesheet" href="/styles.css">
    </head>

    <body>
        <h1>Edit Book</h1>
        <form action="/editBook/<%= genre %>/<%= id %>" method="POST">
            <label for="newBookTitle">Book Title: </label>
            <input type="text" name="editedBookTitle" placeholder="Book Title" required />
            <label for="newAuthorName">Author Name: </label>
            <input type="text" name="editedAuthorName" placeholder="Author Name" required />
            <p>Genre: <%= genre %>
            <label for="newBookDate">Release Date: </label>
            <input type="date" name="editedBookDate" required />
            <button type="submit">Save Details</button>
        </form>
        <a href="/<%= genre %>"> Back to '<%= genre %>' books</a>
    </body>
</html>