<%# GET / %>
<!DOCTYPE html>

<html>
    <head>
        <title>Inventory Application</title>
        <link rel="stylesheet" href="/styles.css">
    </head>

    <body>
        <% genres.forEach((genre) => { %>
            <form action="/<%= genre.name %>" method="POST">
                <button type="submit"><%= genre.name %></button>
            </form>

            <form action="/<%= genre.name %>/delete" method="POST">
                <button type="submit">Delete</button>
            </form>
             
            <a href="/editGenre/<%= genre.name %>">Edit Genre</a>
        <% }) %>
        <a href="/newGenre">Add Genre</a>
    </body>
</html>