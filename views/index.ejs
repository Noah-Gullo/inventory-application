<%# GET / %>
<!DOCTYPE html>

<html>
    <head>
        <title>Inventory Application</title>
        <link rel="stylesheet" href="/styles.css">
    </head>

    <body>
        <h1>Inventory Application</h1>
        <% genres.forEach((genre) => { %>
            <div class="genre">
                <form action="/<%= genre.name %>" method="POST">
                    <button class="genreButton" type="submit"><%= genre.name %></button>
                </form>

                <form action="/<%= genre.name %>/delete" method="POST">
                    <button type="submit">Delete</button>
                </form>
                
                <a href="/editGenre/<%= genre.name %>">Edit Genre</a>
            </div>
        <% }) %>
        <a id="newGenre" href="/newGenre">Add Genre</a>
    </body>
</html>