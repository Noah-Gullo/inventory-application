<%# GET /newBook %>
<!DOCTYPE html>

<html>
    <head>
        <title>Inventory Application</title>
        <link rel="stylesheet" href="/styles.css">
    </head>

    <body>
        <h1>Add Book</h1>
        <form action="/newBook/<%= genre %>" method="POST">
            <label for="newBookTitle">Book Title: </label>
            <input type="text" name="newBookTitle" placeholder="Book Title" required />
            <label for="newAuthorName">Author Name: </label>
            <input type="text" name="newAuthorName" placeholder="Author Name" required />
            <p>Genre: <%= genre %>
            <label for="newBookDate">Release Date: </label>
            <input type="date" name="newBookDate" required />
            <button type="submit">Save Genre</button>
        </form>
        <a href="/<%= genre %>"> Back to '<%= genre %>' books</a>
    </body>
</html>